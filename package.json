{
  "name": "audiorip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 0.0.0.0 --port 3000\" \"cross-env API_PORT=3001 node server/index.js\"",
    "api:dev": "cross-env API_PORT=3001 node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "concurrently -k -n web,api \"vite preview --host 0.0.0.0 --port 3000\" \"cross-env API_PORT=3001 node server/index.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
